        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"exactitud_factual\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"maximum\": 5,\n      \"description\": \"Puntaje del 1 al 5 asignado por el evaluador\"\n    },\n    \"estado_veredicto\": {\n      \"type\": \"string\",\n      \"enum\": [\"ACEPTADO\", \"CORREGIR\", \"RECHAZADO\"],\n      \"description\": \"Veredicto final según el umbral de exactitud\"\n    },\n    \"diagnostico\": {\n      \"type\": \"string\",\n      \"description\": \"Explicación concisa del veredicto o correcciones sugeridas\"\n    }\n  },\n  \"required\": [\n    \"exactitud_factual\",\n    \"estado_veredicto\",\n    \"diagnostico\"\n  ]\n}"
