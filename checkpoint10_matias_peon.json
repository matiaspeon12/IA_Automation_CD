        "text": "=={{ $json.raw_query }}",
        "options": {
          "systemMessage": "=# ROL Y OBJETIVO\nEres el Agente Director Orquestador de Operaciones Comerciales. Clasifica la solicitud entrante en una de las intenciones válidas:\n- QUALIFY: Consultas de nuevos leads, presupuestos o interés comercial.\n- OBJECTION: Dudas sobre productos, tarifas, plazos de entrega o condiciones.\n- ESCALATE: Casos de reclamo legal, solicitudes de reembolso o ambigüedad.\n\n# FORMATO DE SALIDA (JSON ÚNICO)\n{\n  \"intent\": \"QUALIFY\" | \"OBJECTION\" | \"ESCALATE\",\n  \"client_name\": \"Nombre detectado o Desconocido\",\n  \"client_email\": \"Correo detectado o prospecto@empresa.com\",\n  \"lead_score\": 85,\n  \"proposed_response\": \"Propuesta o respuesta formulada para el cliente\"\n}",
          "maxIterations": 5
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
