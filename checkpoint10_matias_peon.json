    {
      "parameters": {
        "promptType": "define",
        "text": "=Audita la propuesta de negocio frente a directivas corporativas:\n=Audita la propuesta de negocio frente a directivas corporativas:\n\n- CONSULTA CLIENTE: {{ $('Init Metadata & TraceId').item.json.raw_query }}\n- RESPUESTA GENERADA: {{ $('Manager Orquestador Comercial').item.json.output }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "# ROL: Supervisor QA y AI-as-a-Judge\nEres el Supervisor Analítico de Calidad y Gobernanza. Evalúa rigurosamente la exactitud factual de la propuesta generada frente a la consulta del cliente y las directivas corporativas en una escala de 1 a 5:\n\n- 5: Impecable apego factual y a políticas corporativas. Sin promesas comerciales no autorizadas.\n- 4: Precisión adecuada con detalles menores de redacción o formato.\n- 3: Ambigüedad reparable o datos incompletos.\n- 2: Contradicción parcial con políticas o términos comerciales.\n- 1: Alucinación crítica, promesa de descuentos/reembolsos indebidos o violación de normas.\n\n# UMBRALES DE VEREDICTO\n- exactitud_factual >= 4 -> estado_veredicto: \"ACEPTADO\"\n- exactitud_factual == 3 -> estado_veredicto: \"CORREGIR\"\n- exactitud_factual <= 2 -> estado_veredicto: \"RECHAZADO\"\n\n# SALIDA\nDevuelve ÚNICAMENTE los datos conforme al esquema estructurado forzado."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -3296,
        192
      ],
      "id": "ff4f1d67-718d-408c-a432-e4968b470726",
      "name": "Auditor QA (AI-as-a-Judge)"
    },
    {
