    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.user_query }}",
        "options": {
          "systemMessage": "=[INICIO DE CONTEXTO COMPARTIDO]\nTrace ID Activo: {{ $json.traceId }}\n[FIN DEL CONTEXTO COMPARTIDO]\n\n# ROL Y OBJETIVO\nEres el Agente Manager Orquestador de Operaciones. Clasifica la intención y extrae las variables clave.\n\n# TAXONOMÍA OBLIGATORIA\n- SALES: Consultas comerciales, presupuestos o cotizaciones.\n- SUPPORT: Fallas, problemas técnicos o tickets.\n- ESCALATE: Casos ambiguos o solicitud expresa de humano.\n\n# FORMATO DE SALIDA (JSON ÚNICO)\n{\n  \"intent\": \"SALES\" | \"SUPPORT\" | \"ESCALATE\",\n  \"client_name\": \"Nombre extraído o Prospecto\",\n  \"client_email\": \"Email extraído o contacto@cliente.com\",\n  \"proposed_answer\": \"Texto de respuesta comercial o técnica estructurada para el cliente.\"\n}",
          "maxIterations": 5
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -2528,
        -16
      ],
      "id": "d1c4d77f-bba5-4679-a189-722f3359c2b7",
      "name": "Manager Triaje (Intent & Answer)"
    },
    {
      "parameters": {
        "options": {
          "temperature": 0.1
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        -2640,
        208
      ],
      "id": "7d2ee796-e5d6-4cce-b997-eb0ab1362159",
      "name": "Google Gemini (Manager)",
      "credentials": {
        "googlePalmApi": {
          "id": "E6qPzkAcy5YIlKii",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Audita la respuesta propuesta por el agente operativo:\n\n- QUERY ORIGINAL: {{ $('Generador de traceId & Timestamp').item.json.user_query }}\n- RESPUESTA PROPUESTA: {{ $json.output }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "# ROL Y OBJETIVO\nEres el Supervisor de Calidad y Gobernanza (AI-as-a-Judge). Audita la fidelidad factual y evalúa sesgos, alucinaciones o riesgos de seguridad en la respuesta.\n\n# RÚBRICA FACTUAL (1-5)\n- 5: Perfecta precisión, neutralidad ética y apego a políticas.\n- 4: Precisión sólida con diferencias menores de formato.\n- 3: Faltan datos o ambigüedad reparable.\n- 2: Inconsistencias o afirmaciones no verificables.\n- 1: Alucinación severa, promesa desautorizada o sesgo crítico.\n\n# UMBRALES DE VEREDICTO\n- exactitud_factual >= 4  --> estado_veredicto: \"ACEPTADO\"\n- exactitud_factual == 3  --> estado_veredicto: \"CORREGIR\"\n- exactitud_factual <= 2  --> estado_veredicto: \"RECHAZADO\""
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -2256,
        -16
      ],
      "id": "3d77efbc-fdf8-4366-8beb-7324dd37f778",
      "name": "Supervisor QA (Juez LLM)"
    },
    {
      "parameters": {
        "options": {
          "temperature": 0
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        -2352,
        208
      ],
      "id": "ba975a27-22a1-4642-a6e0-a663782277bf",
      "name": "Google Gemini (Modelo Juez)",
      "credentials": {
        "googlePalmApi": {
          "id": "E6qPzkAcy5YIlKii",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"exactitud_factual\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"maximum\": 5,\n      \"description\": \"Puntaje numérico del 1 al 5 asignado por la rúbrica de auditoría factual\"\n    },\n    \"estado_veredicto\": {\n      \"type\": \"string\",\n      \"enum\": [\"ACEPTADO\", \"CORREGIR\", \"RECHAZADO\"],\n      \"description\": \"Veredicto final según el umbral de gobernanza\"\n    },\n    \"critica_diagnostico\": {\n      \"type\": \"string\",\n      \"description\": \"Justificación detallada del veredicto, hallazgos de sesgo o inconsistencias detectadas\"\n    }\n  },\n  \"required\": [\"exactitud_factual\", \"estado_veredicto\", \"critica_diagnostico\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        -2160,
        208
      ],
      "id": "ef1d2907-d5e3-40af-8c74-4a5699eafcd8",
