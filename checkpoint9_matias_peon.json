              "type": "number"
            },
            {
              "id": "c2",
              "name": "completionTokensEst",
              "value": "={{ Math.round(($('Manager Triaje (Intent & Answer)').item.json.output.length + 150) / 4) }}",
              "type": "number"
            },
            {
              "id": "c3",
              "name": "totalCostUsd",
              "value": "={{ Number((((Math.round(($('Generador de traceId & Timestamp').item.json.user_query.length + 800) / 4) * 0.075) / 1000000) + ((Math.round(($('Manager Triaje (Intent & Answer)').item.json.output.length + 150) / 4) * 0.30) / 1000000)).toFixed(6)) }}",
              "type": "number"
            },
            {
              "id": "c4",
              "name": "latencyMs",
              "value": "={{ $now.toMillis() - $('Generador de traceId & Timestamp').item.json.startTimeMs }}",
              "type": "number"
